APP_NAME=Crediping
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
FRONTEND_URL=http://localhost:5173
# Comma-separated list of origins allowed to call the API (defaults to FRONTEND_URL)
CORS_ALLOWED_ORIGINS=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=crediping
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# redis in production; "database" also works for local development
QUEUE_CONNECTION=redis

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Meta WhatsApp Cloud API. APP_SECRET enables webhook signature validation,
# VERIFY_TOKEN is used for the webhook subscription handshake. Per-business
# access tokens and phone number ids are stored (encrypted) via the API.
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_URL=https://graph.facebook.com/v22.0
# Embedded Signup ("Connect WhatsApp"): configuration id from the Meta app,
# a System User token of the platform business, and the credit line every
# connected WABA is billed to. MANUAL_CONNECT=true only for local development.
WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=
WHATSAPP_PLATFORM_TOKEN=
WHATSAPP_CREDIT_LINE_ID=
WHATSAPP_CREDIT_LINE_CURRENCY=NGN
WHATSAPP_MANUAL_CONNECT=false

# Platform administrator (signs in at /admin/login). Seed with: php artisan db:seed --class=SuperAdminSeeder
SUPER_ADMIN_NAME="Crediping Admin"
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
